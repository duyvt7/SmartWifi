<Window x:Class="CraneWifi.WidgetApp.Views.MiniWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crane Wi-Fi Monitor" 
        Height="100" Width="290"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        LocationChanged="Window_LocationChanged">

    <Window.Resources>
        <!-- Pulse Animation for Warning/Error -->
        <Storyboard x:Key="PulseStoryBoard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="GlowEffect" 
                             Storyboard.TargetProperty="Opacity" 
                             From="0.2" To="0.8" Duration="0:0:1" />
        </Storyboard>
    </Window.Resources>

    <Grid Margin="8">
        <!-- Glassmorphism Container with Shadow -->
        <Border CornerRadius="14" Background="#E60F172A" BorderBrush="#55334155" BorderThickness="1.5">
            <Border.Effect>
                <DropShadowEffect x:Name="GlowEffect" BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.5" Color="#00E676"/>
            </Border.Effect>

            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 1. Wi-Fi Signal Vector Icon -->
                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Path x:Name="WifiIconPath" Width="32" Height="32" Stretch="Uniform"
                          Data="M12,3C7.79,3 3.7,4.41 0.38,7C0,7.3 0,7.8 0.3,8.1L11.3,19.1C11.7,19.5 12.3,19.5 12.7,19.1L23.7,8.1C24,7.8 24,7.3 23.6,7C20.3,4.41 16.21,3 12,3M12,5C15.6,5 19.1,6.2 22,8.4L12,18.4L2,8.4C4.9,6.2 8.4,5 12,5M12,7.5C9.4,7.5 6.9,8.4 4.8,10L12,17.2L19.2,10C17.1,8.4 14.6,7.5 12,7.5Z"
                          Fill="{StaticResource NeonGreenBrush}" />
                </Grid>

                <!-- 2. Connection Info & Status -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <!-- SSID + Signal Quality -->
                    <DockPanel>
                        <TextBlock x:Name="TxtSsid" Text="CHƯA KẾT NỐI" 
                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                   FontFamily="Segoe UI" FontWeight="Bold" FontSize="13" 
                                   TextTrimming="CharacterEllipsis" MaxWidth="120" DockPanel.Dock="Left" />
                        <TextBlock x:Name="TxtSignalPercent" Text=" (0%)" 
                                   Foreground="{StaticResource CyanAccentBrush}" 
                                   FontFamily="Segoe UI" FontWeight="Bold" FontSize="13" />
                    </DockPanel>

                    <!-- Ping Latency & BSSID -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                        <Border x:Name="LatencyBadge" CornerRadius="4" Background="#26334D" Padding="5,1" Margin="0,0,6,0">
                            <TextBlock x:Name="TxtLatency" Text="Server: -- ms" 
                                       Foreground="{StaticResource TextSecondaryBrush}" 
                                       FontFamily="Segoe UI Semibold" FontSize="10" />
                        </Border>
                    </StackPanel>

                    <!-- Status Description Badge -->
                    <TextBlock x:Name="TxtStatusBadge" Text="Hệ thống ổn định" 
                               Foreground="{StaticResource NeonGreenBrush}" 
                               FontFamily="Segoe UI" FontSize="10.5" 
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- 3. Open Kiosk Gear Button -->
                <Button Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0"
                        Width="36" Height="36" Cursor="Hand" Click="BtnOpenKiosk_Click"
                        ToolTip="Mở Bảng điều khiển Kiosk">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="gearBorder" CornerRadius="8" Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
                                <Path Width="18" Height="18" Stretch="Uniform" Fill="{StaticResource TextSecondaryBrush}"
                                      Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="gearBorder" Property="Background" Value="#334155"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>

