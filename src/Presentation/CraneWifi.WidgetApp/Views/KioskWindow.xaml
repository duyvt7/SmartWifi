<Window x:Class="CraneWifi.WidgetApp.Views.KioskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crane Wi-Fi Controller - Kiosk Panel" 
        Height="780" Width="1180"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource BgDarkBrush}"
        Closing="Window_Closing">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content: Bento Grid -->
            <RowDefinition Height="*" />
            <!-- Footer Bar / Status -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="14,10" Background="#162032" CornerRadius="10" BorderBrush="#334155" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <!-- Close to Mini-Widget Button -->
                <Button DockPanel.Dock="Right" Width="44" Height="40" Margin="6,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}" Background="#334155"
                        Click="BtnMinimizeToWidget_Click" ToolTip="Thu nhỏ về Mini-Widget">
                    <TextBlock Text="✕" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />
                </Button>

                <!-- Full Exit Button -->
                <Button DockPanel.Dock="Right" Height="40" Padding="12,4" Margin="6,0,6,0"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="BtnExitApplication_Click" ToolTip="Thoát hoàn toàn phần mềm">
                    <TextBlock Text="THOÁT ỨNG DỤNG" FontSize="12" FontWeight="Bold" />
                </Button>

                <!-- Title & Machine Identity -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0" Fill="{StaticResource CyanAccentBrush}"
                          Data="M12,3C7.79,3 3.7,4.41 0.38,7C0,7.3 0,7.8 0.3,8.1L11.3,19.1C11.7,19.5 12.3,19.5 12.7,19.1L23.7,8.1C24,7.8 24,7.3 23.6,7C20.3,4.41 16.21,3 12,3Z" />
                    <TextBlock Text="CRANE WI-FI CONTROLLER" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Border Margin="12,0,0,0" Padding="8,2" CornerRadius="6" Background="#0F172A" BorderBrush="{StaticResource CyanAccentBrush}" BorderThickness="1">
                        <TextBlock Text="KIOSK ADMIN MODE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyanAccentBrush}" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Main Bento Grid Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Column 1: Server Watchdog & Numpad -->
                <ColumnDefinition Width="1.1*" />
                <!-- Column 2: Smart Wi-Fi & Roaming -->
                <ColumnDefinition Width="1.1*" />
                <!-- Column 3: OS Controls & Live Log -->
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <!-- CARD 1: SERVER WATCHDOG & TOUCH NUMPAD -->
            <Border Grid.Column="0" Margin="0,0,10,0" Style="{StaticResource GlassCard}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="📡 GIÁM SÁT MÁY CHỦ (WATCHDOG)" 
                               FontSize="14" FontWeight="Bold" Foreground="{StaticResource CyanAccentBrush}" Margin="0,0,0,12" />

                    <!-- Reset Threshold Info -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="10" Background="#162032" CornerRadius="8">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Ngưỡng mất mạng trước khi Reset:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBlock x:Name="TxtResetThresholdValue" Text="45s" FontWeight="Bold" Foreground="{StaticResource NeonGreenBrush}" HorizontalAlignment="Right" />
                            </DockPanel>
                            <Slider x:Name="SliderResetThreshold" Minimum="15" Maximum="120" Value="45" SmallChange="5" LargeChange="15" 
                                    ValueChanged="SliderResetThreshold_ValueChanged" />
                        </StackPanel>
                    </Border>

                    <!-- Server Input Box + On-Screen Touch Numpad -->
                    <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="10" Background="#162032" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Thêm máy chủ mới (Chạm để nhập IP):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtServerInput" Style="{StaticResource IndustrialTextBox}" Text="192.168.1." />
                                <Button Grid.Column="1" Content="LƯU" Width="60" Margin="6,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="BtnAddServer_Click" />
                            </Grid>

                            <!-- On-Screen Numpad for Touchscreen -->
                            <UniformGrid Rows="4" Columns="3" HorizontalAlignment="Center">
                                <Button Content="1" Style="{StaticResource NumpadKeyStyle}" Click="Numpad_Click" />
                                <Button Content="2" Style="{StaticResource NumpadKeyStyle}" Click="Numpad_Click" />
                                <Button Content="3" Style="{StaticResource NumpadKeyStyle}" Click="Numpad_Click" />
                                <Button Content="4" Style="{StaticResource NumpadKeyStyle}" Click="Numpad_Click" />
                                <Button Content="5" Style="{StaticResource NumpadKeyStyle}" Click="Numpad_Click" />
                                <Button Content="6" Style="{StaticResource NumpadKeyStyle}" Click="Numpad_Click" />
                                <Button Content="7" Style="{StaticResource NumpadKeyStyle}" Click="Numpad_Click" />
                                <Button Content="8" Style="{StaticResource NumpadKeyStyle}" Click="Numpad_Click" />
                                <Button Content="9" Style="{StaticResource NumpadKeyStyle}" Click="Numpad_Click" />
                                <Button Content="." Style="{StaticResource NumpadKeyStyle}" Click="Numpad_Click" />
                                <Button Content="0" Style="{StaticResource NumpadKeyStyle}" Click="Numpad_Click" />
                                <Button Content="⌫" Style="{StaticResource NumpadKeyStyle}" Background="#4A252B" Click="NumpadBackspace_Click" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Server List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ServersItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="10,8" Background="#162032" CornerRadius="8" BorderBrush="#334155" BorderThickness="1">
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right" Content="XÓA" FontSize="11" Width="50" Height="30"
                                                    Style="{StaticResource DangerButtonStyle}" Tag="{Binding Address}" Click="BtnRemoveServer_Click" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Address}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{Binding StatusColor}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding LatencyText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- CARD 2: SMART WI-FI & ROAMING -->
            <Border Grid.Column="1" Margin="5,0,5,0" Style="{StaticResource GlassCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="📶 QUẢN LÝ WI-FI &amp; FAST ROAMING" 
                                   FontSize="14" FontWeight="Bold" Foreground="{StaticResource CyanAccentBrush}" Margin="0,0,0,12" />

                        <!-- Current Connection Card -->
                        <Border Padding="12" Background="#162032" CornerRadius="8" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="TRẠM KẾT NỐI HIỆN TẠI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Border HorizontalAlignment="Right" Padding="6,2" CornerRadius="4" Background="#0F172A">
                                        <TextBlock x:Name="TxtWifiBand" Text="5 GHz" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyanAccentBrush}" />
                                    </Border>
                                </DockPanel>

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock x:Name="TxtDetailSsid" Text="PORT_CRANE_5G" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="TxtDetailSignal" Text="88%" FontSize="16" FontWeight="Bold" Foreground="{StaticResource NeonGreenBrush}" HorizontalAlignment="Right" />
                                </DockPanel>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="BSSID (MAC):" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="TxtDetailBssid" Text="--:--:--:--:--:--" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Kênh (Channel):" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                        <TextBlock x:Name="TxtDetailChannel" Text="Channel 36" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Cường độ RSSI:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="TxtDetailRssi" Text="-55 dBm" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Tốc độ Link:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                        <TextBlock x:Name="TxtDetailSpeed" Text="300 Mbps" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Roaming Settings -->
                        <Border Padding="12" Background="#162032" CornerRadius="8" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Tự động Fast Roaming (Chuyển AP sóng khỏe):" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <CheckBox x:Name="ChkEnableRoaming" HorizontalAlignment="Right" IsChecked="True" Checked="ChkEnableRoaming_Changed" Unchecked="ChkEnableRoaming_Changed" />
                                </DockPanel>

                                <DockPanel Margin="0,4,0,2">
                                    <TextBlock Text="Độ lệch Hysteresis để nhảy sóng:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="TxtHysteresisValue" Text="+15%" FontWeight="Bold" Foreground="{StaticResource CyanAccentBrush}" HorizontalAlignment="Right" />
                                </DockPanel>
                                <Slider x:Name="SliderHysteresis" Minimum="5" Maximum="30" Value="15" SmallChange="1" LargeChange="5" ValueChanged="SliderHysteresis_ValueChanged" />

                                <Button Margin="0,10,0,0" Content="QUÉT &amp; CHUYỂN SÓNG NGAY" Style="{StaticResource PrimaryButtonStyle}" Click="BtnScanAndRoamNow_Click" />
                            </StackPanel>
                        </Border>

                        <!-- Ping Failover & Quarantine Settings -->
                        <Border Padding="12" Background="#162032" CornerRadius="8" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Tự chuyển Wi-Fi khi mất Ping Server:" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <CheckBox x:Name="ChkEnableFailover" HorizontalAlignment="Right" IsChecked="True" Checked="ChkEnableFailover_Changed" Unchecked="ChkEnableFailover_Changed" />
                                </DockPanel>

                                <DockPanel Margin="0,4,0,2">
                                    <TextBlock Text="Ngưỡng mất Ping để đổi Wi-Fi:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="TxtFailoverThresholdValue" Text="15s" FontWeight="Bold" Foreground="{StaticResource AmberWarningBrush}" HorizontalAlignment="Right" />
                                </DockPanel>
                                <Slider x:Name="SliderFailoverThreshold" Minimum="5" Maximum="40" Value="15" SmallChange="1" LargeChange="5" ValueChanged="SliderFailoverThreshold_ValueChanged" />

                                <DockPanel Margin="0,8,0,2">
                                    <TextBlock Text="Thời gian tạm khóa Wi-Fi lỗi:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="TxtBlacklistDurationValue" Text="5 phút" FontWeight="Bold" Foreground="{StaticResource RedDangerBrush}" HorizontalAlignment="Right" />
                                </DockPanel>
                                <Slider x:Name="SliderBlacklistDuration" Minimum="1" Maximum="30" Value="5" SmallChange="1" LargeChange="5" ValueChanged="SliderBlacklistDuration_ValueChanged" />

                                <DockPanel Margin="0,10,0,0">
                                    <TextBlock x:Name="TxtQuarantinedCount" Text="Mạng đang bị khóa: 0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <Button x:Name="BtnClearBlacklist" Content="XÓA KHÓA TẤT CẢ" Padding="10,4" FontSize="11" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Click="BtnClearBlacklist_Click" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Preferred Wi-Fi Networks -->
                        <Border Padding="12" Background="#162032" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Mạng Wi-Fi cấu hình sẵn (Plaintext Password):" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <ItemsControl x:Name="PreferredWifiItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Padding="8" Background="#0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding PriorityText}" DockPanel.Dock="Left" FontWeight="Bold" Foreground="{StaticResource CyanAccentBrush}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Ssid}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding PasswordMasked}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CARD 3: OS CONTROLS & LIVE LOG CONSOLE -->
            <Border Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource GlassCard}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="🛠 HỆ ĐIỀU HÀNH &amp; NHẬT KÝ SỰ KIỆN" 
                               FontSize="14" FontWeight="Bold" Foreground="{StaticResource CyanAccentBrush}" Margin="0,0,0,12" />

                    <!-- OS Mode Indicators -->
                    <Border DockPanel.Dock="Top" Padding="12" Background="#162032" CornerRadius="8" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Airplane Mode:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtAirplaneStatus" Text="LOCKED OFF" FontWeight="Bold" Foreground="{StaticResource NeonGreenBrush}" HorizontalAlignment="Right" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Tablet Mode:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtTabletStatus" Text="LOCKED OFF" FontWeight="Bold" Foreground="{StaticResource NeonGreenBrush}" HorizontalAlignment="Right" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Tự bật cùng Windows (Task Scheduler):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <CheckBox x:Name="ChkAutoStart" HorizontalAlignment="Right" IsChecked="True" Checked="ChkAutoStart_Changed" Unchecked="ChkAutoStart_Changed" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Network Adapter Selector & Emergency Reset Button -->
                    <Border DockPanel.Dock="Top" Padding="12" Background="#162032" CornerRadius="8" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Card mạng Wi-Fi thực thi:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbAdapters" Margin="0,0,0,10" Height="36" SelectionChanged="CmbAdapters_SelectionChanged" />

                            <Button Content="🚨 LÀM MỚI MẠNG NGAY (FORCE RESET)" 
                                    Height="48" Style="{StaticResource DangerButtonStyle}" 
                                    Click="BtnForceResetAdapter_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Live Log Console -->
                    <Border Padding="10" Background="#090D16" CornerRadius="8" BorderBrush="#334155" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock Text="LIVE LOG CONSOLE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <Button Content="Xóa màn hình" HorizontalAlignment="Right" FontSize="10" Padding="6,2" 
                                        Background="#1E293B" Foreground="{StaticResource TextSecondaryBrush}" 
                                        Click="BtnClearLogs_Click" />
                            </DockPanel>

                            <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="TxtLiveLogs" IsReadOnly="True" Background="Transparent" BorderThickness="0" 
                                         Foreground="#A7F3D0" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 3. Footer Bar -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,6" Background="#162032" CornerRadius="8">
            <DockPanel>
                <TextBlock Text="Tự động cứu hộ và ghi nhật ký hoạt động 24/7 • Giữ tối đa 7 ngày log trên ổ cứng" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock x:Name="TxtFooterTime" Text="2026-10-29 11:45:00" FontSize="11" Foreground="{StaticResource CyanAccentBrush}" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
