<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>CraneWifi.WidgetApp</RootNamespace>
    <AssemblyName>CraneWifiController</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Modules\Company.Core.Abstractions\Company.Core.Abstractions.csproj" />
    <ProjectReference Include="..\..\Modules\Company.Module.ConfigManager\Company.Module.ConfigManager.csproj" />
    <ProjectReference Include="..\..\Modules\Company.Module.OsTweaks\Company.Module.OsTweaks.csproj" />
    <ProjectReference Include="..\..\Modules\Company.Module.NetworkWatchdog\Company.Module.NetworkWatchdog.csproj" />
    <ProjectReference Include="..\..\Modules\Company.Module.SmartWifi\Company.Module.SmartWifi.csproj" />
  </ItemGroup>

</Project>
